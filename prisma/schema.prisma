// Prisma schema — Core schema v1 (roadmap Phase 1, task 2).
//
// Contains ONLY the Phase 1 tables: BusinessProfile, Service, ServiceArea,
// QuoteRequest, LeadPhoto. Every other model in ARCHITECTURE.md "Data model"
// (LocationServicePage, PricingRule, Review, AdminUser, CallTrackingNumber, ...)
// and the columns that reference them (e.g. ServiceArea.isIndexable,
// QuoteRequest.assignedAdminId / callTrackingNumberId) are added by additive
// migrations in the roadmap phase that introduces them.
//
// Conventions:
// - Primary keys are Postgres `uuid`, generated by the database.
// - Timestamps are `timestamptz`; `updatedAt` also has a DB default so raw
//   inserts (seeds, scripts) stay valid.
// - Content fields whose real values the business has not supplied yet
//   (license, insurance, years in business, pricing, images, SEO overrides)
//   are nullable so nothing has to be invented to create a row.

// Prisma 7: the client is generated into src/generated/prisma (gitignored) and
// connects through the node-postgres driver adapter (see src/lib/prisma.ts).
// Connection URLs live in prisma.config.ts (CLI) and DATABASE_URL (runtime).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Business ────────────────────────────────────────────────────────────────

/// Singleton-ish: one row today, more if the business adds locations later.
model BusinessProfile {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  phone                   String   @db.VarChar(32)
  email                   String   @db.VarChar(254)
  address                 String
  city                    String
  state                   String   @db.VarChar(2)
  zip                     String   @db.VarChar(10)
  /// Opening hours keyed by day, e.g. { "mon": { "open": "08:00", "close": "18:00" } }.
  hours                   Json
  licenseNumber           String?
  insuranceInfo           String?
  yearsInBusiness         Int?
  guarantees              String[] @default([])
  paymentMethodsAccepted  String[] @default([])
  googleBusinessProfileId String?
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// ─── Content ─────────────────────────────────────────────────────────────────

model Service {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String   @unique @db.VarChar(100)
  name             String
  shortDescription String
  /// Markdown.
  longDescription  String
  /// Ordered array of { title, body }.
  processSteps     Json
  pricingGuidance  String?
  /// R2 URL (images arrive with real photos; never placeholders of fake jobs).
  heroImage        String?
  isActive         Boolean  @default(true)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  leads QuoteRequest[]
}

/// A town/neighborhood served. Phase 1 lists these on one static page;
/// per-town landing pages (and `isIndexable`) arrive in Phase 2.
model ServiceArea {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String   @unique @db.VarChar(100)
  name             String
  state            String   @db.VarChar(2)
  county           String?
  zipCodes         String[] @default([])
  lat              Float?
  lng              Float?
  heroImage        String?
  /// Unique copy per town — required before a town page is published (Phase 2).
  introContent     String?
  /// Landmarks / local notes.
  localProofPoints Json?
  /// schema.org GeoShape / areaServed data.
  geoShape         Json?
  isActive         Boolean  @default(false)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  leads QuoteRequest[]

  // Lead intake matches a submitted ZIP against zipCodes (`has` → array containment).
  @@index([zipCodes], type: Gin)
}

// ─── Leads ───────────────────────────────────────────────────────────────────

enum LeadStatus {
  new
  contacted
  quoted
  booked
  lost
}

enum LeadSource {
  organic
  gbp
  ads
  direct
  referral
  direct_mail
}

/// A quote request (lead). Phone + ZIP are the hard requirements; whether the
/// form also requires email/address is decided by the quote form (task 8).
model QuoteRequest {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  phone             String     @db.VarChar(32)
  email             String?    @db.VarChar(254)
  address           String?
  zip               String     @db.VarChar(10)
  serviceId         String?    @db.Uuid
  /// Matched from `zip` against ServiceArea.zipCodes at intake.
  locationId        String?    @db.Uuid
  description       String?
  /// Ballpark estimate range (Phase 3 estimator).
  estimatedPriceMin Decimal?   @db.Decimal(10, 2)
  estimatedPriceMax Decimal?   @db.Decimal(10, 2)
  status            LeadStatus @default(new)
  source            LeadSource @default(direct)
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmTerm           String?
  utmContent        String?
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  // Leads are business records: removing a service or town must not delete them.
  service  Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  location ServiceArea? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  photos   LeadPhoto[]

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([serviceId])
  @@index([locationId])
}

/// Photo attached to a lead. Schema only in Phase 1 — uploads arrive in Phase 3.
model LeadPhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId     String   @db.Uuid
  url        String
  /// R2 object key; one row per stored object.
  storageKey String   @unique
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  lead QuoteRequest @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}
