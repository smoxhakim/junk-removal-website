# Copy to .env (never commit .env). Values marked "Phase N" are not used until
# that roadmap phase; leave them blank until then.

# ── Database (Neon Postgres) — required ──────────────────────────────────────
# Runtime queries: Neon POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require"
# Migrations (prisma migrate): Neon DIRECT connection string (no "-pooler").
# The Neon <> Vercel integration sets both of these automatically.
# Locally it may be omitted, in which case DATABASE_URL is used for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# ── Resend (email) — Phase 1, task 8 ─────────────────────────────────────────
RESEND_API_KEY=""
LEAD_NOTIFICATION_EMAIL="owner@example.com"

# ── Upstash Redis (rate limiting) — Phase 1, task 8 ──────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Google Analytics 4 — Phase 1, task 12 (only client-exposed value) ────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# ── Cloudflare Turnstile (bot protection, see ARCHITECTURE "Auth & security") ─
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Cloudflare R2 (object storage) — Phase 3 ─────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ── Auth.js (admin) — Phase 4 ────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me"

# ── Twilio (SMS + call tracking) — Phase 4 / Phase 6 ─────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Cron secret (Vercel Cron auth header) — Phase 2+ ─────────────────────────
CRON_SECRET=""
